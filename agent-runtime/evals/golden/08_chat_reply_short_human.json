    },
    "text": "Tomás, ¿cómo vamos de flujo de caja este mes?",
    "conversation": "office",
    "intent": "question",
    "topic": "finance",
    "responder_role": "primary",
    "agents": [
      {
        "id": "accounting",
        "role": "accounting",
        "title": "Contador",
        "name": "Tomás"
      },
      {
        "id": "sales",
        "role": "sales",
        "title": "Gerente de Ventas",
        "name": "Valeria"
      },
      {
        "id": "assistant",
        "role": "assistant",
        "title": "Asistente",
        "name": "Sofía"
      }
    ],
    "locale": "es"
  },
  "rubric": {
    "text_non_empty": true,
