{
  "id": "chat_reply_short_human",
  "description": "Chat reply (the most frequent live call): the accountant answers a cash question briefly, as a person, with no invented figures and no JSON or markup leaking into the text.",
  "endpoint": "/v1/chat-reply",
  "request": {
    "agent": {
      "id": "accounting",
      "role": "accounting",
      "title": "Contador",
      "name": "Tomás",
