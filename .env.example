# Proveedores de modelo por defecto: DeepSeek y Anthropic. Sin ninguna clave el runtime corre en modo
# simulación (demo guionado, sin costo). Con ambas claves se usa DeepSeek primero y Anthropic de respaldo;
# con solo una, esa es la predeterminada (la pantalla de ajustes muestra cuál). MODEL por defecto: deepseek/deepseek-chat
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Gemini (Google AI Studio). With its key, Gemini goes first (gemini-3.6-flash, low reasoning). Set
# PLATFORM_LLM_PROVIDER=gemini so Settings > AI model shows it as the included model.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
PLATFORM_LLM_PROVIDER=
# Opcional: fuerza tarifas USD por millon de tokens para costo/presupuesto
# PRICE_IN_PER_M=
# PRICE_OUT_PER_M=
SIMULATION=
MODEL=
# Secreto compartido backend <-> runtime (recomendado en producción): openssl rand -hex 32
RUNTIME_TOKEN=
# Cookie del refresh token (HttpOnly, SameSite=Strict). Secure queda activo por defecto; docker-compose.yml
# lo apaga para el desarrollo en http plano. En producción déjalo en true.
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_NAME=wfai_refresh
# Techo de proveedores de modelo permitidos por el operador (deepseek,anthropic,custom; vacío = todos los configurados).
# Cada organización puede restringirlo más en PUT /api/v1/settings/model-policy, nunca ampliarlo.
ALLOWED_PROVIDERS=
BUDGET_USD=25
# v1: integraciones de un proveedor concreto (Gmail, Google Calendar/Drive, GitHub, LinkedIn, Microsoft, Slack) apagadas.
# on = todas (comportamiento anterior), o una lista: github,slack. custom_api y las importaciones genéricas no dependen de esto.
VENDOR_INTEGRATIONS=
# Public base of the API (".../api/v1"), shown as the push URL of the data inboxes (and used by SSO). Empty =
# UI_BASE_URL + /api/v1, or the browser's own origin in the admin UI.
# PUBLIC_API_URL=https://app.example.com/api/v1
# Importar desde un enlace (docs/architecture/link-imports.md): aceptar enlaces http:// sin cifrar (por defecto
# sólo https). Las direcciones privadas siguen CUSTOM_API_ALLOW_PRIVATE; el tamaño máximo, DRIVE_MAX_FILE_MB.
LINK_IMPORTS_ALLOW_HTTP=false

# --- Archivos (docs/architecture/drive.md) ---
# docker-compose.yml ya trae el S3 interno (RustFS, servicio objects). Credenciales de desarrollo por defecto;
# en producción, propias (openssl rand -hex 16 / -hex 32).
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Tope por archivo de las subidas en streaming (disco temporal -> S3). Por defecto 500 con S3, 25 sin S3 (máx. 64).
# DRIVE_MAX_UPLOAD_MB=500
# Tope de lo que se escribe en memoria (agentes, buzones, enlaces) y cuota por organización.
# DRIVE_MAX_FILE_MB=25
# DRIVE_QUOTA_MB=5120

# --- Búsqueda por significado (docs/architecture/agent-search.md) ---
# Vacío = solo palabras. gemini usa GEMINI_API_KEY (o EMBEDDINGS_API_KEY) con gemini-embedding-2 a 1536 dimensiones.
# Nivel gratuito: cuota muy baja y Google usa los datos; nada de documentos reales de clientes.
# EMBEDDINGS_PROVIDER=gemini
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=gemini-embedding-2
# EMBEDDINGS_DIMENSIONS=1536
# EMBEDDINGS_DAILY_TOKENS=2000000
# EMBEDDINGS_PRICE_PER_M=0.20

# --- Sandbox de código y render de páginas PDF (docs/architecture/code-sandbox.md) ---
# `make up-sandbox` lo levanta con el perfil "sandbox". Topes de cada ejecución:
# SANDBOX_MEMORY_MB=512
# SANDBOX_CPUS=1
