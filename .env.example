# Sin clave el runtime corre en modo simulación (demo guionado, sin costo).
ANTHROPIC_API_KEY=
# DeepSeek: tiene prioridad sobre Anthropic si esta definida. MODEL por defecto: deepseek/deepseek-chat
DEEPSEEK_API_KEY=
# Opcional: fuerza tarifas USD por millon de tokens para costo/presupuesto
# PRICE_IN_PER_M=
# PRICE_OUT_PER_M=
SIMULATION=
MODEL=
# Secreto compartido backend <-> runtime (recomendado en producción): openssl rand -hex 32
RUNTIME_TOKEN=
# Techo de proveedores de modelo permitidos por el operador (deepseek,anthropic,custom; vacío = todos los configurados).
# Cada organización puede restringirlo más en PUT /api/v1/settings/model-policy, nunca ampliarlo.
ALLOWED_PROVIDERS=
BUDGET_USD=25
