# Copiar a .env.prod (NO commitear) y rellenar. Uso:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# Generar secretos:  openssl rand -hex 32   (hex evita caracteres especiales en URLs)

# --- Dominio / TLS (Caddy + Let's Encrypt) ---
DOMAIN=app.ejemplo.com
ACME_EMAIL=ops@ejemplo.com
# Origen(es) permitidos por CORS/WebSocket del backend (coma-separados, con https://)
ALLOWED_ORIGINS=https://app.ejemplo.com

# --- Imagenes ---
# Usuario/organizacion de GitHub duenos de los paquetes GHCR (minusculas)
OWNER=tu-usuario
# Tag a desplegar: sha-<commit> publicado por CI (ej. sha-1a2b3c4) o un release
TAG=sha-0000000

# --- Postgres (obligatorio) ---
POSTGRES_USER=workforce
POSTGRES_DB=workforce
POSTGRES_PASSWORD=CAMBIAR_openssl_rand_hex_32

# --- Redis (obligatorio) ---
REDIS_PASSWORD=CAMBIAR_openssl_rand_hex_32
REDIS_MAXMEMORY=256mb

# --- Backend ---
# Secreto de firma JWT (min. 32 caracteres). Rotarlo invalida todas las sesiones.
JWT_SECRET=CAMBIAR_openssl_rand_hex_32
# Tope de gasto en USD
BUDGET_USD=25
# Endpoint de reset de demo: dejar en false en produccion
ENABLE_DEMO_RESET=false
# Proxies cuyo X-Forwarded-For se respeta (CIDRs/IPs, coma-separados). Vacio = la IP fija de
# Caddy en la red `internal` (172.31.250.10, ver docker-compose.prod.yml), que es lo correcto
# con el compose tal cual. Solo si hay otro proxy/CDN delante de Caddy: anadir sus rangos y
# mantener 172.31.250.10. Nunca poner 0.0.0.0/0 (cualquiera podria falsear su IP).
TRUSTED_PROXIES=

# --- Boveda de conexiones (credenciales de integraciones) ---
# Clave que envuelve las claves de datos de la boveda: base64 de 32 bytes.
#   openssl rand -base64 32
# Vacia = solo funcionan las conexiones simuladas (no se guarda ninguna credencial real).
# RESPALDARLA aparte de la base de datos (gestor de secretos): sin ella las credenciales
# guardadas son irrecuperables. Para rotar: mover la actual a CONNECTIONS_KEK_PREVIOUS y
# generar una nueva en CONNECTIONS_KEK.
CONNECTIONS_KEK=
CONNECTIONS_KEK_PREVIOUS=
# Fuentes de API genericas: permitir direcciones privadas/LAN solo en autoalojado sobre una red
# de confianza (docs/architecture/integrations-credentials.md, sec. 18.8). Dejar en false.
CUSTOM_API_ALLOW_PRIVATE=false
# Importar desde un enlace (docs/architecture/link-imports.md): aceptar enlaces http:// sin cifrar. Dejar en false.
LINK_IMPORTS_ALLOW_HTTP=false

# --- Agent runtime ---
# Al menos una clave de modelo. Con GEMINI_API_KEY, Gemini responde primero (gemini-3.6-flash).
GEMINI_API_KEY=CAMBIAR_clave_de_Google_AI_Studio
DEEPSEEK_API_KEY=
# Modelo "incluido" que muestra Ajustes > Modelo de IA (debe coincidir con la clave de arriba).
PLATFORM_LLM_PROVIDER=gemini
# v1: integraciones de un proveedor concreto apagadas (on | lista: github,slack).
VENDOR_INTEGRATIONS=
# Secreto compartido backend -> runtime (Authorization: Bearer). El compose lo pasa a ambos
# servicios; vacio = llamadas al runtime sin autenticar (el backend lo avisa en el log).
#   openssl rand -hex 32
RUNTIME_TOKEN=CAMBIAR_openssl_rand_hex_32
# Opcionales
ANTHROPIC_API_KEY=
MODEL=

# --- Frontend (solo build local con --build; normalmente vacio) ---
# Vacio = rutas relativas /api/v1 y WS derivado de window.location (recomendado tras Caddy)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
